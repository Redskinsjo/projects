generator client {
  provider             = "prisma-client"
  output               = "../app/generated/prisma"
  importFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ResearchStatus {
  PREPARED
  ACTIVE
  PAUSED
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum OfferSourceType {
  CAREER_SITE
  JOB_BOARD
  SOCIAL_NETWORK
  OTHER
}

enum SearchRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApplicationStatus {
  IN_PROGRESS
  SENT
  INTERVIEW
  ACCEPTED
  REJECTED
}

model User {
  // Stable, provider-qualified OAuth subject, e.g. google:12345.
  id           String        @id
  name         String
  email        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  researches   Research[]
  applications Application[]
  cv           Resume?

  @@map("pkida_users")
}

model Profile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @default("")
  email      String   @default("")
  phone      String   @default("")
  location   String   @default("")
  role       String   @default("")
  salary     Float    @default(40000)
  experience Float    @default(0)
  about      String   @default("")
  updatedAt  DateTime @updatedAt

  @@map("pkida_profiles")
}

model Research {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  role         String
  location     String
  salary       Float
  experience   Float
  contract     String
  remote       String
  pace         Int
  keywords     String         @default("")
  exclusions   String         @default("")
  review       Boolean        @default(true)
  status       ResearchStatus @default(PREPARED)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  lastError    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  applications Application[]
  matches      ResearchMatch[]
  searchRuns   SearchRun[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("pkida_researches")
}

model Application {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchId String?
  // Composite foreign key also prevents linking another account's research.
  research   Research?         @relation(fields: [researchId, userId], references: [id, userId], onDelete: NoAction)
  company    String
  role       String
  location   String
  date       DateTime          @default(now())
  status     ApplicationStatus @default(IN_PROGRESS)
  sourceUrl  String?
  notes      String            @default("")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, date])
  @@index([userId, status])
  @@index([researchId, userId])
  @@map("pkida_applications")
}

model Company {
  id          String      @id @default(uuid())
  name        String
  website     String?
  domain      String?     @unique
  description String      @default("")
  sector      String      @default("")
  industry    String      @default("")
  location    String      @default("")
  metadata    Json?
  offers      JobOffer[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
  @@map("pkida_companies")
}

model JobOffer {
  id             String          @id @default(uuid())
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title          String
  description    String          @default("")
  location       String          @default("")
  employmentType String          @default("")
  workplaceType  String          @default("")
  salaryMin      Float?
  salaryMax      Float?
  salaryCurrency String?
  postedAt       DateTime?
  expiresAt      DateTime?
  status         OfferStatus     @default(ACTIVE)
  canonicalUrl   String          @unique
  rawMetadata    Json?
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  sources        OfferSource[]
  matches        ResearchMatch[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, lastSeenAt])
  @@index([companyId])
  @@map("pkida_job_offers")
}

model OfferSource {
  id           String          @id @default(uuid())
  offerId      String
  offer        JobOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  type         OfferSourceType
  name         String
  sourceUrl    String          @unique
  externalId   String?
  metadata     Json?
  firstSeenAt  DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())

  @@index([offerId])
  @@map("pkida_offer_sources")
}

model ResearchMatch {
  id            String    @id @default(uuid())
  researchId    String
  research      Research  @relation(fields: [researchId], references: [id], onDelete: Cascade)
  offerId       String
  offer         JobOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  score         Int       @default(0)
  matchReasons  Json?
  notifiedAt    DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([researchId, offerId])
  @@index([researchId, notifiedAt, createdAt])
  @@map("pkida_research_matches")
}

model SearchRun {
  id          String         @id @default(uuid())
  researchId  String
  research    Research       @relation(fields: [researchId], references: [id], onDelete: Cascade)
  status      SearchRunStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  resultCount Int            @default(0)
  error       String?

  @@index([researchId, startedAt])
  @@map("pkida_search_runs")
}

model Resume {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  size       Int
  content    Bytes
  uploadedAt DateTime @default(now())

  @@map("pkida_resumes")
}
